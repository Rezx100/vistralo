VISTRALO_SUPABASE_PUBLISHABLE_KEY=sb_publishable_dd9rEPE4GWXzfFlkw7CaeA_PoGduXqt
# Public browser configuration (Vercel); never put a secret key in either variable.
# Plans and Paddle checkout are off unless VISTRALO_BILLING=on. See docs/BILLING.md.
# Sandbox values only: the build refuses a live token. These are public and ship in the bundle.
# VISTRALO_BILLING=on
# VISTRALO_PADDLE_ENV=sandbox
# VISTRALO_PADDLE_CLIENT_TOKEN=test_...
# VISTRALO_PADDLE_PRICE_PRO_MONTH=pri_...
# VISTRALO_PADDLE_PRICE_PRO_YEAR=pri_...
# VISTRALO_PADDLE_PRICE_STUDIO_MONTH=pri_...
# VISTRALO_PADDLE_PRICE_STUDIO_YEAR=pri_...
# VISTRALO_LEGAL_URL=https://...
# VISTRALO_SIGNUP=on
# The Paddle API key and webhook secret are Supabase function secrets (PADDLE_API_KEY,
# PADDLE_WEBHOOK_SECRET). They never go in this file, in Vercel, or in Git.
# The worker reads the same two plus these, from /etc/vistralo-worker.env on the VPS only:
# VISTRALO_ADMIN_EMAIL, VISTRALO_ADMIN_PASSWORD, VISTRALO_CLOUD_DATA_ROOT,
# VISTRALO_DIRECTOR_MODEL (optional), VISTRALO_BUILDREAD_CHROME (optional)

{
  "manifest_version": 3,
  "name": "Vistralo",
  "short_name": "Vistralo",
  "description": "Record a tab, window, screen or camera, then turn it into a narrated walkthrough in Vistralo.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Record with Vistralo",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabCapture",
    "offscreen",
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage"
  ],
  "content_scripts": [
    {
      "matches": [],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "camera.html",
        "camera.js",
        "controls.css",
        "tokens.css",
        "extension.css",
        "theme.js",
        "meter.html",
        "meter.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    },
    {
      "resources": [
        "handoff.html",
        "handoff.js"
      ],
      "matches": []
    }
  ],
  "commands": {
    "toggle-recording": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Start or stop a recording"
    },
    "pause-resume": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Pause or resume the recording"
    },
    "cancel-recording": {
      "description": "Discard the recording under way"
    },
    "toggle-mute": {
      "description": "Mute or unmute the microphone in the recording"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
